# ─── Vapi AI — Emergency Voice Calls ───────────────────────────────────────
# Get from: https://dashboard.vapi.ai → API Keys
VAPI_API_KEY=your_vapi_private_key_here

# Get from: https://dashboard.vapi.ai → Phone Numbers → your purchased number
VAPI_PHONE_NUMBER_ID=your_phone_number_id_here

# Get from: https://dashboard.vapi.ai → Assistants → your assistant → ID
VAPI_ASSISTANT_ID=eeec707c-8499-4b0b-b81e-e9e3d08742e8

# ─── TruGen AI — Video Avatar ────────────────────────────────────────────────
# Get from: https://app.trugen.ai → API Keys
TRUGEN_API_KEY=your_trugen_api_key_here

# Get from: https://app.trugen.ai → Agents → your agent → ID
TRUGEN_AGENT_ID=8700376f-dd31-4ae6-b890-59b4c22f0aab

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGIN=http://localhost:3000
