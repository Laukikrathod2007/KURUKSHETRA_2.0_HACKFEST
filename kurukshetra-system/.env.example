# Copy to .env for local overrides (not committed). On Railway/GCP, set these
# as real environment variables in the platform's dashboard instead.

# Managed Postgres connection string (Railway/Neon/Supabase all work unchanged).
# Falls back to a local SQLite file if unset -- see src/kurukshetra/db.py.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/kurukshetra

# CORS origin for the deployed Vercel frontend (tighten main.py's allow_origins to this).
FRONTEND_ORIGIN=https://midnightciphers.example
